# =========================================================
#  Projet Garanteo — depot volontairement limite aux livrables
#
#  Principe : TOUT est exclu par defaut, et on rouvre
#  explicitement les 3 livrables + le README.
#  Le reste du dossier de travail reste en local.
# =========================================================

# --- tout est exclu ---
/*

# --- sauf ces deux fichiers a la racine ---
!.gitignore
!README.md

# --- sauf le notebook ---
!02_Notebooks/
02_Notebooks/*
!02_Notebooks/main.ipynb

# --- sauf le rapport Power BI, son PDF et les captures de ses 7 pages ---
!04_Dashboard/
04_Dashboard/*
!04_Dashboard/Garanteo_Sophie_Paradon.pbix
!04_Dashboard/Garanteo_Sophie_Paradon.pdf
!04_Dashboard/pages/

# --- sauf la presentation, son PDF et les 3 captures du dashboard ---
!05_Restitution/
05_Restitution/*
!05_Restitution/Garanteo_Restitution.pptx
!05_Restitution/Garanteo_Restitution.pdf
!05_Restitution/captures/
05_Restitution/captures/*
!05_Restitution/captures/1_premier_contact.png
!05_Restitution/captures/2_dernier_contact.png
!05_Restitution/captures/3_infobulle.png
